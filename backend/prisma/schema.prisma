// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model auth {
  id                Int                  @id @unique @default(autoincrement())
  userName          String
  email             String
  passwordHash      String
  sessions          sessions[]
  organizationUsers organization_users[]
}

model guest {
  id              Int           @id @default(autoincrement())
  name            String
  roleDescription String
  email           String
  status          String        @default("PENDING")
  orgId           Int
  organization    organizations @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model sessions {
  id         Int      @id @default(autoincrement())
  userId     Int
  familyId   String   @default(uuid())
  token_hash String   @unique
  expiresAt  DateTime
  isRevoked  Boolean  @default(false)
  users      auth     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model roles {
  id              Int                  @id @default(autoincrement())
  description     Role                 @default(GUEST)
  rolesPermission permissions[]
  orgRoles        organization_users[]
}

model permissions {
  id              Int     @id @default(autoincrement())
  description     String
  rolesPermission roles[]
}

model organizations {
  id                Int                  @id @default(autoincrement())
  name              String               @unique
  email             String               @unique
  description       String
  organizationUsers organization_users[]
  guests            guest[]
}

model organization_users {
  id     Int    @id @default(autoincrement())
  userId Int
  orgId  Int
  roleId Int
  email  String

  auth         auth          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization organizations @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role         roles         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId, roleId])
  @@index([userId])
  @@index([orgId])
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
  GUEST
}
