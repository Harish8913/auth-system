// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model auth {
  id           Int     @id @unique @default(autoincrement())
  logical_id   String? @unique @default(uuid())
  firstName    String
  lastName     String? 
  userName     String
  email        String
  passwordHash String
  tenantId     Int

  tenants           organizations        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions          sessions[]
  organizationUsers organization_users[]

  @@unique([email, tenantId])
}

model guest {
  id              Int           @id @default(autoincrement())
  logical_id      String?       @unique @default(uuid())
  name            String
  roleDescription String
  email           String
  status          String        @default("PENDING")
  tenantId        Int
  organization    organizations @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([email, tenantId])
}

model sessions {
  id         Int      @id @default(autoincrement())
  logical_id String?  @unique @default(uuid())
  userId     Int
  familyId   String   @default(uuid())
  token_hash String   @unique
  expiresAt  DateTime
  isRevoked  Boolean  @default(false)
  users      auth     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model roles {
  id              Int                  @id @default(autoincrement())
  logical_id      String?              @unique @default(uuid())
  description     Role                 @default(GUEST)
  rolesPermission permissions[]
  orgRoles        organization_users[]
}

model permissions {
  id              Int     @id @default(autoincrement())
  logical_id      String? @unique @default(uuid())
  description     String
  rolesPermission roles[]
}

model organizations {
  id                Int                  @id @default(autoincrement())
  logical_id        String?              @unique @default(uuid())
  name              String               @unique
  email             String               @unique
  description       String
  organizationUsers organization_users[]
  guests            guest[]
  auths             auth[]
}

model organization_users {
  id         Int     @id @default(autoincrement())
  logical_id String? @unique @default(uuid())
  userId     Int
  tenantId   Int
  roleId     Int

  auth         auth          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization organizations @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role         roles         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId, roleId])
  @@index([userId])
  @@index([tenantId])
}

enum Role {
  DEVELOPER
  ADMIN
  MANAGER
  EMPLOYEE
  GUEST
}
