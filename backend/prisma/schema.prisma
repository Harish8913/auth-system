// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model users {
  id                Int                  @id @unique @default(autoincrement())
  userName          String               @unique
  email             String               @unique
  status            String?
  passwordHash      String
  sessions          sessions[]
  usersRoles        roles[]
  organizationUsers organization_users[]
}

model guest {
  id     Int         @id @default(autoincrement())
  email  String
  status GuestStatus
}

model sessions {
  id         Int      @id @default(autoincrement())
  userId     Int
  familyId   String   @default(uuid())
  token_hash String   @unique
  expiresAt  DateTime
  isRevoked  Boolean  @default(false)
  users      users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model roles {
  id              Int                  @id @default(autoincrement())
  description     Role                 @default(GUEST)
  rolesPermission permissions[]
  usersRoles      users[]
  orgRoles        organization_users[]
}

model permissions {
  id              Int     @id @default(autoincrement())
  description     String
  rolesPermission roles[]
}

model organizations {
  id                Int                  @id @default(autoincrement())
  name              String               @unique
  description       String
  organizationUsers organization_users[]
}

model organization_users {
  id Int @id @default(autoincrement())

  userId Int
  orgId  Int
  roleId Int

  user         users         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization organizations @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role         roles[]

  @@unique([userId, orgId, roleId])
  @@index([userId])
  @@index([orgId])
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
  GUEST
}

enum GuestStatus {
  PENDING
  ACCEPTED
}
